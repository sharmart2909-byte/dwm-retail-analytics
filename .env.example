# =====================================================================
# Online Retail DWM Analytics Project - Environment Configuration
# Copy this file to .env (do not commit .env to source control)
# =====================================================================

# MySQL Database Configuration
# Set the password for the MySQL 'root' user (required by Spring Boot)
DB_PASSWORD=your_mysql_root_password_here

# Initial Administrator Bootstrap Credentials (Optional)
# If no administrator exists in the database, these credentials will be initialized.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_secure_password

# Python Data Mining Service URL
PYTHON_SERVICE_URL=http://localhost:8000

# Frontend API Base URL (React Vite)
# Default for local development is http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
